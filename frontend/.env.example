# Which backend: mock (in-browser fake), supabase (database + auth + storage), http (FastAPI + MQTT)
VITE_BACKEND=mock

# Supabase (VITE_BACKEND=supabase). The publishable key is safe in the browser; never put the service key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# FastAPI + Mosquitto (VITE_BACKEND=http). With supabase, VITE_API_URL is optional and only used for the handover briefing.
VITE_API_URL=https://192.168.50.10:8443
VITE_MQTT_URL=wss://192.168.50.10:8084
VITE_SHIP_ID=demo-ship
