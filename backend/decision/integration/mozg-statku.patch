+# pilnosc = klucz odpowiedzi Basala: "0" -> P3 (rutyna), "2" -> P1 (pilne)
+def _answers(dzial="engine", dzial_p=0.95, pilnosc=0, dpa=False, osoba="2nd_engineer", osoba_p=0.9,
+             sektor="engine", sektor_p=0.8):
+    def choice(keys, pick, p):
+        rest = (1 - p) / (len(keys) - 1)
+        return {k: (p if k == pick else rest) for k in keys}
+    q = decision.config()["questions"]
+    return {
+        "dzial": {"probabilities": choice(list(q["dzial"]["criteria"]), dzial, dzial_p), "confidence": dzial_p},
+        "pilnosc": {"probabilities": choice(["0", "1", "2"], str(pilnosc), 0.7), "confidence": 0.7},
+        "raport_dpa": {"probabilities": choice(["true", "false"], "true" if dpa else "false", 0.97), "confidence": 0.97},
+        "osoba": {"probabilities": choice(list(q["osoba"]["criteria"]), osoba, osoba_p), "confidence": osoba_p},
+        "sektor": {"probabilities": choice(list(q["sektor"]["criteria"]), sektor, sektor_p), "confidence": sektor_p},
+    }
+
+
+@pytest.fixture
+def fake_basal(monkeypatch):
+    state = {"answers": _answers(), "requests": []}
+
+    class H(BaseHTTPRequestHandler):
+        def log_message(self, *a):
+            pass
+
+        def do_POST(self):
+            body = json.loads(self.rfile.read(int(self.headers["content-length"])))
+            state["requests"].append(body)
+            out = json.dumps({"model": "fake-basal", "answers": state["answers"]}).encode()
+            self.send_response(200)
+            self.send_header("content-type", "application/json")
+            self.end_headers()
+            self.wfile.write(out)
+
+    srv = HTTPServer(("127.0.0.1", 0), H)
+    threading.Thread(target=srv.serve_forever, daemon=True).start()
+    monkeypatch.setenv("BASAL_URL", f"http://127.0.0.1:{srv.server_port}/v1/systemone")
+    monkeypatch.setenv("DECISION_ENABLED", "1")
+    yield state
+    srv.shutdown()
+
+
+CTX = {"report_id": "r1", "crew": {"crew_id": "marek", "role": "motorman", "lang": "pl"},
+       "equipment": json.loads((decision.CONFIG_PATH.parent / "equipment.json").read_text()), "round": 0}
