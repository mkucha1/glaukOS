# Warstwa decyzyjna (Basal) — skopiuj do .env i dostosuj:  cp .env.example .env
# .env jest w .gitignore (nie commitujemy lokalnych ustawień).

# Statek — to samo co VITE_SHIP_ID we frontend/.env.example (tematy MQTT ship/{shipId}/...)
SHIP_ID=demo-ship

# Serwer modelu decyzyjnego (basal-serve). Na serwerze pokładowym zwykle ten sam laptop co backend.
BASAL_HOST=127.0.0.1
BASAL_PORT=8000
BASAL_URL=http://127.0.0.1:8000/v1/systemone
BASAL_TIMEOUT=600

# Model i wersja silnika. Mac (Apple Silicon): MLX-8bit; Linux + NVIDIA: Remek/basal-2.0-4.5B (MODE=fast-nocompile)
BASAL_MODEL=Remek/basal-2.0-4.5B-MLX-8bit
BASAL_VERSION=v2.8.1

# Pytania i progi pewności (ścieżka względem backend/decision/)
DECISION_QUESTIONS=config/questions.yaml

# Opcjonalnie: token Hugging Face (szybsze pobieranie modeli, wyższe limity). Nie commitować.
HF_TOKEN=
